{
   "$schema": "https://docs.renovatebot.com/renovate-schema.json",
   "extends": [
      "config:best-practices",
      ":semanticCommitTypeAll(chore)",
      "github>teamony-labs/renovate-config"
   ],
   "labels": ["dependencies", "renovate"],
   "rangeStrategy": "bump",
   "enabledManagers": [
      "npm",
      "dockerfile",
      "docker-compose",
      "github-actions",
      "pep621"
   ],
   "ignoreDeps": ["node", "npm"],
   "lockFileMaintenance": {
      "automerge": true
   },
   "packageRules": [
      {
         "description": "Python は TensorFlow が対応するまで 3.13 に留める",
         "matchDepNames": ["python"],
         "allowedVersions": "<3.14"
      },
      {
         "description": "requires-python は依存ではなく対応範囲の宣言なので更新しない",
         "matchManagers": ["pep621"],
         "matchDepNames": ["python"],
         "enabled": false
      },
      {
         "description": "base-ui は RC のため、どの更新も破壊的になりうる。Dependency Dashboard で承認したものだけ PR にする",
         "matchPackageNames": ["@base-ui-components/react"],
         "dependencyDashboardApproval": true
      }
   ]
}
